{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.venv/**,.env,.env.*,tests/**,__pycache__/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index"}
  ]
}
